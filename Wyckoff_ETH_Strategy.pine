//@version=5
strategy("Wyckoff ETH Strategy", shorttitle="Wyckoff ETH", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.05, slippage=2, pyramiding=0)

// ============ 参数 ============
grp1 = "核心参数"
lookback = input.int(50, "吸筹/派发周期", group=grp1)
volSpike = input.float(1.8, "放量倍数", step=0.1, group=grp1)
breakLen = input.int(20, "突破参考周期", group=grp1)

grp2 = "趋势过滤(日线)"
useTrendFilter = input.bool(true, "启用日线趋势过滤", group=grp2)
trendFast = input.int(20, "日线 EMA 快", group=grp2)
trendSlow = input.int(50, "日线 EMA 慢", group=grp2)

grp3 = "风险管理"
atrLen = input.int(14, "ATR 周期", group=grp3)
slMult = input.float(2.0, "止损 ATR 倍数", step=0.1, group=grp3)
tp1Mult = input.float(1.5, "TP1 ATR 倍数", step=0.1, group=grp3)
tp2Mult = input.float(3.0, "TP2 ATR 倍数", step=0.1, group=grp3)
tp3Mult = input.float(5.0, "TP3 ATR 倍数", step=0.1, group=grp3)

// ============ 基础指标 ============
atrVal = ta.atr(atrLen)
volAvg = ta.sma(volume, lookback)
upperBreak = ta.highest(high, breakLen)[1]
lowerBreak = ta.lowest(low, breakLen)[1]

// ============ 日线趋势(MTF) ============
dailyEmaFast = request.security(syminfo.tickerid, "D", ta.ema(close, trendFast), lookahead=barmerge.lookahead_off)
dailyEmaSlow = request.security(syminfo.tickerid, "D", ta.ema(close, trendSlow), lookahead=barmerge.lookahead_off)
dailyUp = dailyEmaFast > dailyEmaSlow
dailyDn = dailyEmaFast < dailyEmaSlow
trendOkBuy = not useTrendFilter or dailyUp
trendOkSell = not useTrendFilter or dailyDn

// ============ 放量突破信号 ============
volBig = volume > volAvg * volSpike
breakoutUp = close > upperBreak and volBig
breakoutDn = close < lowerBreak and volBig

// ============ 综合信号 ============
buySignal = breakoutUp and trendOkBuy
sellSignal = breakoutDn and trendOkSell

// ============ 策略执行 ============
if buySignal and strategy.position_size == 0
    slPrice = close - atrVal * slMult
    tp1 = close + atrVal * tp1Mult
    tp2 = close + atrVal * tp2Mult
    tp3 = close + atrVal * tp3Mult
    strategy.entry("Long", strategy.long)
    strategy.exit("TP1", "Long", qty_percent=50, limit=tp1, stop=slPrice)
    strategy.exit("TP2", "Long", qty_percent=30, limit=tp2, stop=slPrice)
    strategy.exit("TP3", "Long", limit=tp3, stop=slPrice)

if sellSignal and strategy.position_size == 0
    slPrice = close + atrVal * slMult
    tp1 = close - atrVal * tp1Mult
    tp2 = close - atrVal * tp2Mult
    tp3 = close - atrVal * tp3Mult
    strategy.entry("Short", strategy.short)
    strategy.exit("TP1", "Short", qty_percent=50, limit=tp1, stop=slPrice)
    strategy.exit("TP2", "Short", qty_percent=30, limit=tp2, stop=slPrice)
    strategy.exit("TP3", "Short", limit=tp3, stop=slPrice)

// ============ 可视化 ============
plotshape(buySignal, title="BUY", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, text="BUY", size=size.normal)
plotshape(sellSignal, title="SELL", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, text="SELL", size=size.normal)

plot(dailyEmaFast, "Daily EMA Fast", color=color.orange)
plot(dailyEmaSlow, "Daily EMA Slow", color=color.blue, linewidth=2)

bgcolor(useTrendFilter and dailyUp ? color.new(color.green, 95) : useTrendFilter and dailyDn ? color.new(color.red, 95) : na)

// ============ 信息面板 ============
var table panel = table.new(position.top_right, 2, 5, border_width=1)
if barstate.islast
    table.cell(panel, 0, 0, "Wyckoff ETH", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 0, syminfo.ticker + " " + timeframe.period, bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(panel, 0, 1, "日线趋势", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 1, 1, dailyUp ? "多头" : dailyDn ? "空头" : "震荡", bgcolor=dailyUp ? color.new(color.green, 50) : dailyDn ? color.new(color.red, 50) : color.gray, text_color=color.white, text_size=size.tiny)
    table.cell(panel, 0, 2, "ATR", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 1, 2, str.tostring(atrVal, format.mintick), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 0, 3, "SL/TP1/TP3", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 1, 3, str.tostring(slMult) + "x / " + str.tostring(tp1Mult) + "x / " + str.tostring(tp3Mult) + "x", text_color=color.white, text_size=size.tiny)
    table.cell(panel, 0, 4, "放量阈值", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 1, 4, str.tostring(volSpike) + "x 均量", text_color=color.white, text_size=size.tiny)
