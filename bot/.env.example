# ============================================================
# 币安合约实盘交易机器人配置
# 复制此文件为 .env 并填入你的实际值
# ============================================================

# ===== 1. 交易所 API 密钥 =====
# 币安: https://www.binance.com/zh-CN/my/settings/api-management
# OKX:  https://www.okx.com/account/my-api
EXCHANGE=binance                       # binance 或 okx
API_KEY=你的_API_KEY
API_SECRET=你的_API_SECRET
API_PASSPHRASE=                        # OKX 需要,币安留空

# ===== 2. 交易环境 =====
USE_TESTNET=true                       # true=测试网(强烈建议先测1周), false=实盘
SANDBOX_MODE=false                     # 仅模拟,不下真实单 (策略调试用)

# ===== 3. 交易对与周期 =====
SYMBOL=ETH/USDT:USDT                   # 合约格式 (币安U本位永续)
TIMEFRAME=4h                           # K线周期
LEVERAGE=3                             # 杠杆倍数 (≤3 安全)

# ===== 4. 资金管理 =====
POSITION_SIZE_PCT=10                   # 单笔仓位占总资金百分比 (建议 5-15%)
MAX_POSITIONS=1                        # 最大同时持仓数
MIN_BALANCE_USDT=50                    # 最小账户余额,低于此禁止开单

# ===== 5. 策略参数 (与 Pine 一致) =====
ADX_MIN=25
SL_ATR_MULT=3.0
RR_MULT=1.67
RSI_LONG_MIN=40
RSI_LONG_MAX=70
RSI_SHORT_MIN=30
RSI_SHORT_MAX=60
TOUCH_TOL_PCT=0.5

# ===== 6. 共振模式 =====
# reverse: 逆向+中性 (实测最优,胜率62%, PF 3.00)
# pure:    纯 4H,不看日线
# forward: 顺向共振 (传统,当前行情亏钱)
RESONANCE_MODE=reverse
DAILY_STRONG_PCT=5.0                   # 日线强趋势阈值

# ===== 7. 告警通知 =====
ENABLE_NOTIFICATIONS=true

# 飞书 (推荐,免费且好用)
# 教程: https://open.feishu.cn/document/client-docs/bot-v3/add-custom-bot
FEISHU_WEBHOOK=                        # 飞书机器人 webhook URL

# Telegram
# 创建机器人: 与 @BotFather 对话
TG_BOT_TOKEN=                          # Telegram Bot Token
TG_CHAT_ID=                            # 你的 chat_id (给机器人发消息后访问 https://api.telegram.org/bot<TOKEN>/getUpdates)

# ===== 8. 风控 =====
MAX_DAILY_LOSS_PCT=5                   # 单日最大亏损% (触发后停止交易24h)
MAX_CONSECUTIVE_LOSSES=3               # 最大连亏笔数 (触发后停止1轮周期)
